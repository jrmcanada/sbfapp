# Copy to .env and fill in from your Supabase project's Settings > API page.
# .env is gitignored — never commit real values.

# Public: safe to expose client-side. RLS is what actually protects data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private: server-only, never sent to the browser. Bypasses RLS — treat as a secret.
SUPABASE_SECRET_KEY=
